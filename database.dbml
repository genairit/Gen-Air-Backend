Project nest_server_infrastructure {
  database_type: 'PostgreSQL'
  Note: 'GenAir CRM MVP schema. Keep in sync with the SQL files in migrations/.'
}

Enum project_detail_field_set {
  company        [note: 'בנייה רוויה, מסחרי: company name, ח.פ / ת.פ, address, phone, email']
  private_client [note: 'פרטי, יוקרה: name, address, city, phone, email, floor, apartment']
  institution    [note: 'מוסד: name, מ״ע, phone, address, email, floor, unit']
}

Enum payment_terms {
  installments_10_60_30 [note: '10-60-30 — פרטי, יוקרה']
  prepaid               [note: 'תשלום מראש — פרטי, יוקרה']
  milestones_net_60     [note: 'לפי אבני דרך (שוטף + 60) — מסחרי, בנייה רוויה, מוסד']
  twelve_prepaid_checks [note: '12 צ׳קים מראש — מסחרי, בנייה רוויה, מוסד']
  other                 [note: 'אחר — every project type; the terms are described in projects.payment_terms_note']
}

Enum user_role {
  system_admin
  secretary
  project_manager
  lead_installer
}

Table users {
  id                   uuid         [pk, default: `gen_random_uuid()`]
  employee_number      varchar(16)  [not null, unique, note: 'EMP-1001']
  first_name           varchar(60)  [not null]
  last_name            varchar(60)  [not null]
  email                citext       [not null, unique]
  phone                varchar(20)  [not null]
  role                 user_role    [not null]
  password_hash        varchar(255) [not null]
  created_at           timestamptz(3)  [not null, default: `now()`]
  updated_at           timestamptz(3)  [not null, default: `now()`]
  deleted_at           timestamptz(3)

  indexes {
    role
  }
}

Enum priority_sync_status {
  pending [note: 'Saved in the CRM, waiting for Priority to confirm']
  synced  [note: 'Priority returned an id; priority_id and priority_synced_at are set']
  failed  [note: 'Priority did not accept the customer; saved in the CRM only, retry needed']
}

Table customers {
  id                     uuid                     [pk, default: `gen_random_uuid()`]
  customer_type          project_detail_field_set [not null, note: 'Same three kinds as project types: company, private client, institution']
  name                   varchar(200)             [not null]
  tax_id                 varchar(9)               [not null, note: 'ח.פ / ת.פ / ת.ז / מ״ע, 9 digits; unique among non-deleted customers']
  address                varchar(200)             [not null]
  contact_name           varchar(120)             [not null, note: 'Main contact (איש קשר ראשי)']
  phone                  varchar(20)              [not null, note: 'Main contact phone: mobile or landline']
  email                  citext                   [not null, note: 'Main contact email']
  priority_id            varchar(64)              [note: 'Id returned by Priority; unique when set; required when synced']
  priority_sync_status   priority_sync_status     [not null, default: 'pending']
  priority_synced_at     timestamptz(3)
  priority_sync_attempts integer                  [not null, default: 0]
  priority_sync_error    varchar(500)             [note: 'Last Priority failure, shown on the customer screen']
  created_by_id          uuid                     [not null, ref: > users.id]
  created_at             timestamptz(3)           [not null, default: `now()`]
  updated_at             timestamptz(3)           [not null, default: `now()`]
  deleted_at             timestamptz(3)

  indexes {
    tax_id [unique]
    priority_id [unique]
    priority_sync_status
    name
    created_by_id
  }
}

Table project_stages {
  id          uuid         [pk, default: `gen_random_uuid()`]
  name        varchar(80)  [not null]
  description varchar(255)
  tag         varchar(60)
  color       varchar(7)
  position    integer      [not null, note: 'Unique among non-deleted stages; drives board column order']
  created_at  timestamptz(3)  [not null, default: `now()`]
  updated_at  timestamptz(3)  [not null, default: `now()`]
  deleted_at  timestamptz(3)
}

Table project_types {
  id          uuid         [pk, default: `gen_random_uuid()`]
  name        varchar(80)  [not null, unique]
  subtitle    varchar(120)
  description varchar(500)
  tag         varchar(80)
  icon        varchar(40)
  position    integer      [not null]
  detail_field_set project_detail_field_set [not null, note: 'Which customer detail fields projects of this type require']
  created_at  timestamptz(3)  [not null, default: `now()`]
  updated_at  timestamptz(3)  [not null, default: `now()`]
}

Table projects {
  id              uuid         [pk, default: `gen_random_uuid()`]
  code            varchar(8)   [not null, unique, note: 'Generated on save: creator first_name + last_name initials, then a 5-digit random number (e.g. אכ-48213)']
  name            varchar(200) [not null]
  project_type_id uuid         [not null, ref: > project_types.id]
  stage_id        uuid         [not null, ref: > project_stages.id]
  created_by_id   uuid         [not null, ref: > users.id]
  drive_folder_id varchar(128) [note: 'Root project folder; subfolders are read live from Drive']
  erp_reference   varchar(64)
  erp_synced_at   timestamptz(3)
  customer_name               varchar(200) [note: 'Company, private client or institution name, depending on the project type']
  customer_company_number     varchar(9)   [note: 'ח.פ / ת.פ — commercial and multi-unit projects']
  customer_association_number varchar(9)   [note: 'מ״ע — institutional projects']
  customer_address            varchar(200)
  customer_city               varchar(80)  [note: 'Private and luxury projects']
  customer_phone              varchar(20)
  customer_email              varchar(254)
  customer_floor              smallint     [note: 'Private, luxury and institutional projects; negative for underground floors']
  customer_apartment          varchar(10)  [note: 'Private and luxury projects']
  customer_unit               varchar(60)  [note: 'Institutional projects: unit or wing']
  payment_terms               payment_terms [note: 'Legal options per project type are a module-layer rule']
  payment_terms_note          varchar(300) [note: 'Free-text terms; only set when payment_terms is other']
  address                     varchar(255) [note: 'Project site address as formatted by Google Places; set together with address_place_id']
  address_place_id            text         [note: 'Google Places id; its presence marks the address as verified']
  address_city                varchar(80)  [note: 'Locality component of the Places result']
  contact_name                varchar(120) [note: 'Project contact person: full name']
  contact_phone               varchar(20)  [note: 'Project contact person: Israeli mobile']
  contact_role                varchar(60)  [note: 'Project contact person: role, e.g. מנהל פרויקט']
  created_at      timestamptz(3)  [not null, default: `now()`]
  updated_at      timestamptz(3)  [not null, default: `now()`]
  deleted_at      timestamptz(3)

  indexes {
    stage_id
    project_type_id
  }
}

Table project_members {
  id         uuid        [pk, default: `gen_random_uuid()`]
  project_id uuid        [not null, ref: > projects.id]
  user_id    uuid        [not null, ref: > users.id]
  role       user_role   [not null]
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, default: `now()`]

  indexes {
    (project_id, role) [unique]
    user_id
  }
}

Table project_stage_transitions {
  id              uuid         [pk, default: `gen_random_uuid()`]
  project_id      uuid         [not null, ref: > projects.id]
  from_stage_id   uuid         [ref: > project_stages.id]
  to_stage_id     uuid         [not null, ref: > project_stages.id]
  changed_by_id   uuid         [not null, ref: > users.id]
  changed_by_role user_role    [not null, note: 'Snapshot of the role at the time of the change']
  note            varchar(255)
  created_at      timestamptz(3)  [not null, default: `now()`]
  updated_at      timestamptz(3)  [not null, default: `now()`]

  indexes {
    (project_id, created_at)
  }
}

Table drive_template_folders {
  id         uuid         [pk, default: `gen_random_uuid()`]
  parent_id  uuid         [ref: > drive_template_folders.id]
  name       varchar(200) [not null, note: 'May contain {Project_ID}, {Project_Name}']
  position   integer      [not null]
  created_at timestamptz(3)  [not null, default: `now()`]
  updated_at timestamptz(3)  [not null, default: `now()`]
}
