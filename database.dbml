Project nest_server_infrastructure {
  database_type: 'PostgreSQL'
  Note: 'GenAir CRM MVP schema. Keep in sync with migrations/. Public application tables have RLS enabled and Data API roles have no direct grants.'
}

Enum project_detail_field_set {
  company        [note: 'בנייה רוויה, מסחרי: company name, ח.פ / ת.פ, address, phone, email']
  private_client [note: 'פרטי, יוקרה: name, address, city, phone, email, floor, apartment']
  institution    [note: 'מוסד: name, מ״ע, phone, address, email, floor, unit']
}

Enum user_role {
  system_admin    [note: 'הנהלה / מנהל מערכת']
  engineer        [note: 'עובד הנדסה']
  secretary       [note: 'מזכירה']
  project_manager [note: 'מנהל פרויקט']
  finance         [note: 'מחלקת כספים']
  installer       [note: 'מתקין / טכנאי שטח']
}

Table users {
  id                   uuid         [pk, default: `gen_random_uuid()`, note: 'Internal account identifier referenced wherever the schema records who did something']
  employee_number      varchar(16)  [not null, unique, note: 'Human-readable staff number used by the office, for example EMP-1001']
  first_name           varchar(60)  [not null, note: 'Given name; its initial is part of the generated project code']
  last_name            varchar(60)  [not null, note: 'Family name; its initial is part of the generated project code']
  email                citext       [not null, unique, note: 'Login identifier and reply-to address on outgoing quotation emails; citext makes it case-insensitive']
  phone                varchar(20)  [not null, note: 'Phone number of the employee']
  role                 user_role    [not null, note: 'Globally active role; must also appear in user_roles']
  password_hash        varchar(255) [not null, note: 'Hash of the password; the plaintext is never stored']
  session_version      integer      [not null, default: 0, note: 'Incremented on password change to revoke earlier JWTs']
  created_at           timestamptz(3)  [not null, default: `now()`, note: 'When the account was created']
  updated_at           timestamptz(3)  [not null, default: `now()`, note: 'When the account row last changed']
  deleted_at           timestamptz(3)  [note: 'Set when the account is deactivated; null while the account is live']

  indexes {
    role [note: 'Lists everyone currently holding a given role']
  }
  Note: 'Staff accounts. Everyone who logs into the CRM has one row here, and every action elsewhere in the schema points back to it. Soft deleted: rows with deleted_at set can no longer log in but stay referenced by historical records.'
}

Table auth_login_attempts {
  account_key   char(64)    [pk, note: 'HMAC key for a separate account, caller, or global login bucket']
  attempt_count integer     [not null, note: 'Login attempts counted in the current window; always positive, and login is rejected once it exceeds the allowed maximum. Counted before the password is checked, and a successful login clears only the account bucket, so the caller and global buckets also count successful attempts']
  expires_at    timestamptz [not null, note: 'End of the throttling window; after it passes the bucket is treated as empty and can be purged']

  indexes {
    expires_at [name: 'idx_auth_login_attempts_expires_at']
  }
  Note: 'Brute-force throttling counters for login. One row per rate-limit bucket; rows are transient and are cleared once their window expires, so the table holds no identifying data.'
}

Table user_roles {
  id         uuid          [pk, default: `gen_random_uuid()`, note: 'Identifier of the assignment row']
  user_id    uuid          [not null, ref: > users.id, note: 'The user the role is granted to']
  role       user_role     [not null, note: 'A role the user may switch into; permissions come from role_permissions for this role']
  created_at timestamptz(3) [not null, default: `now()`, note: 'When the role was granted']

  indexes {
    user_id
    (user_id, role) [unique, name: 'uq_user_roles_user_id_role']
    (role, user_id) [name: 'idx_user_roles_role_user_id']
  }
  Note: 'Every role a user is allowed to work as. A user may hold several roles and switch between them; users.role holds the one currently active, which must also appear here.'
}

Table user_role_audits {
  id                      uuid          [pk, default: `gen_random_uuid()`, note: 'Identifier of the audit entry']
  actor_id                uuid          [not null, ref: > users.id, note: 'The user who performed the change']
  actor_role              user_role     [not null, note: 'Role active for the actor when the change occurred']
  subject_user_id         uuid          [not null, ref: > users.id, note: 'The user whose roles changed; equals actor_id for a self-service role switch']
  action                  varchar(20)   [not null, note: 'assignment or switch']
  previous_role           user_role     [note: 'Active role before the change; null when there was none']
  next_role               user_role     [note: 'Active role after the change; null when the change only touched assigned roles']
  previous_assigned_roles jsonb         [not null, note: 'Array of the roles the subject held before the change']
  next_assigned_roles     jsonb         [not null, note: 'Array of the roles the subject holds after the change']
  created_at              timestamptz(3) [not null, default: `now()`, note: 'When the change happened']

  indexes {
    (subject_user_id, created_at) [name: 'idx_user_role_audits_subject_created']
    (actor_id, created_at) [name: 'idx_user_role_audits_actor_created']
  }
  Note: 'Append-only history of role changes: who changed whose roles, and what the roles were before and after. Written both when an admin changes someone assigned roles and when a user switches their active role.'
}

Enum priority_sync_status {
  pending [note: 'Saved in the CRM, waiting for Priority to confirm']
  synced  [note: 'Priority returned an id; priority_id and priority_synced_at are set']
  failed  [note: 'Priority did not accept the customer; saved in the CRM only, retry needed']
}

Table customers {
  payment_terms varchar(40) [note: 'Quotation default only; note belongs on quotations']
  id                     uuid                     [pk, default: `gen_random_uuid()`, note: 'Internal customer identifier used by projects, tasks and quotations']
  customer_type          project_detail_field_set [not null, note: 'Same three kinds as project types: company, private client, institution']
  name                   varchar(200)             [not null, note: 'Company, private person or institution name, depending on customer_type']
  tax_id                 varchar(9)               [not null, note: 'ח.פ / ת.פ / ת.ז / מ״ע, 9 digits; unique among non-deleted customers']
  address                varchar(200)             [not null, note: 'Billing address of the customer']
  contact_name           varchar(120)             [not null, note: 'Main contact (איש קשר ראשי)']
  phone                  varchar(20)              [not null, note: 'Main contact phone: mobile or landline']
  email                  citext                   [not null, note: 'Main contact email']
  priority_id            varchar(64)              [note: 'Id returned by Priority; unique when set; required when synced']
  priority_sync_status   priority_sync_status     [not null, default: 'pending', note: 'Where the customer stands in the Priority handshake: pending, synced or failed']
  priority_synced_at     timestamptz(3)           [note: 'When Priority last accepted the customer; null until the first success']
  priority_sync_attempts integer                  [not null, default: 0, note: 'How many times the CRM tried to push the customer to Priority']
  priority_sync_error    varchar(500)             [note: 'Last Priority failure, shown on the customer screen']
  created_by_id          uuid                     [not null, ref: > users.id, note: 'The user who added the customer']
  created_at             timestamptz(3)           [not null, default: `now()`, note: 'When the customer was created']
  updated_at             timestamptz(3)           [not null, default: `now()`, note: 'When the customer row last changed']
  deleted_at             timestamptz(3)           [note: 'Set when the customer is removed; null while active']

  indexes {
    tax_id [unique]
    priority_id [unique]
    priority_sync_status
    name
    created_by_id
  }
  Note: 'The paying client (company, private client or institution) a project and its quotations belong to. Each customer is pushed to Priority, the ERP, and the priority_* columns record how that synchronisation went. Soft deleted.'
}

Table customer_contacts {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identifier of the contact']
  customer_id uuid [not null, ref: > customers.id, note: 'The customer this person belongs to']
  name varchar(200) [not null, note: 'Full name of the contact person']
  phone varchar(20) [note: 'Phone number, when known']
  email varchar(254) [note: 'Email address, used as a recipient of quotation execution emails']
  role varchar(60) [note: 'Free-text function at the customer, for example אדריכל or מנהל פרויקט']
  created_by_id uuid [not null, ref: > users.id, note: 'The user who added the contact']
  created_at timestamptz(3) [not null, default: `now()`, note: 'When the contact was created']
  updated_at timestamptz(3) [not null, default: `now()`, note: 'When the contact row last changed']
  deleted_at timestamptz(3) [note: 'Set when the contact is removed; null while active']

  indexes {
    customer_id
    created_by_id
    (customer_id, name, `coalesce(phone, '')`, `coalesce(email, '')`, `coalesce(role, '')`) [unique, name: 'uq_customer_contacts_active_tuple', note: 'Active rows only: deleted_at IS NULL']
  }
  Note: 'Additional named people at a customer (architect, site manager, accounting) beyond the single main contact stored on the customer. Customer-owned contacts; no automatic main contact or old-contact backfill. Backend-only API/import access; RLS enabled and public client privileges revoked.'
}

Table project_stages {
  id          uuid         [pk, default: `gen_random_uuid()`, note: 'Stage identifier referenced by projects and by stage transitions']
  name        varchar(80)  [not null, note: 'Stage name shown as the board column title']
  description varchar(255) [note: 'Longer explanation of what the stage means']
  tag         varchar(60)  [note: 'Short label used by the client to group or mark the stage']
  color       varchar(7)   [note: 'Hex colour of the board column, for example #8A8D93']
  position    integer      [not null, note: 'Unique among non-deleted stages; drives board column order']
  created_at  timestamptz(3)  [not null, default: `now()`, note: 'When the stage was defined']
  updated_at  timestamptz(3)  [not null, default: `now()`, note: 'When the stage definition last changed']
  deleted_at  timestamptz(3)  [note: 'Set when a stage is retired; retired stages stay for historical transitions']
  Note: 'The project and apartment board statuses. Fixed active catalog: טרם בעבודה, בעבודה, מחכה לתשובה, הושלם, positions 0–3. New projects start טרם בעבודה. Definition writes blocked by project_stages_readonly trigger. Retired rows retain their names for historical transitions.'
}

Table project_types {
  id          uuid         [pk, default: `gen_random_uuid()`, note: 'Project type identifier referenced by projects']
  name        varchar(80)  [not null, unique, note: 'Type name shown when creating a project']
  subtitle    varchar(120) [note: 'Short line shown under the name in the type picker']
  description varchar(500) [note: 'Longer explanation of when to choose this type']
  tag         varchar(80)  [note: 'Short label used by the client to group types']
  icon        varchar(40)  [note: 'Name of the icon the client renders for the type']
  position    integer      [not null, note: 'Display order of the type in the picker']
  detail_field_set project_detail_field_set [not null, note: 'Which customer detail fields projects of this type require']
  can_have_apartments boolean [not null, default: false, note: 'Projects of this type may hold apartments (בנייה רוויה only)']
  created_at  timestamptz(3)  [not null, default: `now()`, note: 'When the type was defined']
  updated_at  timestamptz(3)  [not null, default: `now()`, note: 'When the type definition last changed']
  Note: 'The kinds of project the company takes on (בנייה רוויה, מסחרי, פרטי, יוקרה, מוסד). The type decides which customer detail fields the project screen asks for and whether the project may contain apartments.'
}

Table projects {
  id              uuid         [pk, default: `gen_random_uuid()`, note: 'Internal project identifier referenced by tasks, members, quotations and apartments']
  code            varchar(12)  [not null, unique, note: 'Generated on save: creator first_name + last_name initials, then a 5-digit random number (e.g. אכ-48213). An apartment adds its sequence in the building: אכ-48213-01']
  name            varchar(200) [not null, note: 'Globally unique among active rows (including apartments) after JS outer-whitespace trimming; case-sensitive C collation partial expression index uq_projects_active_exact_name']
  has_general_lighting_ceiling_lowering boolean [not null, default: false, note: 'Whether the whole site lowers the ceiling for general lighting; chk_projects_lighting_height pairs it with the height']
  general_lighting_ceiling_lowering_height double [note: 'Centimeters: finite nonnegative number required when enabled; null when disabled (chk_projects_lighting_height)']
  has_own_lighting boolean [not null, default: false, note: 'Apartments use their stored lighting values when true; otherwise they inherit the current building values']
  project_type_id uuid         [not null, ref: > project_types.id, note: 'The kind of project, which decides the required customer detail fields']
  stage_id        uuid         [not null, ref: > project_stages.id, default: '6502a045-2a7d-4bc8-8ba1-36eaedc49a05', note: 'Insert/assignment trigger rejects archived status IDs']
  customer_id     uuid         [ref: > customers.id, note: 'Linked customer for a project or apartment; legacy apartments retain inline customer/contact fields']
  has_own_team boolean [not null, default: false, note: 'Apartments inherit the building team unless explicitly overridden, including an empty override']
  parent_project_id uuid       [ref: > projects.id, note: 'The building an apartment belongs to; one level only (trigger trg_projects_single_level_nesting)']
  created_by_id   uuid         [not null, ref: > users.id, note: 'The user who opened the project; their initials form the project code']
  drive_folder_id varchar(128) [note: 'Root project folder; subfolders are read live from Drive']
  shared_document_file_id varchar(128) [note: 'One selected parent-project Drive file ID, resolved live by apartments; chk_parent_project_shared_document requires parent_project_id to be null when set']
  priority_id   varchar(64)    [note: 'Identifier of the matching project in Priority, the ERP; null until it is synchronised']
  priority_synced_at   timestamptz(3) [note: 'When the project was last synchronised with Priority']
  customer_name               varchar(200) [note: 'Company, private client or institution name, depending on the project type']
  customer_company_number     varchar(9)   [note: 'ח.פ / ת.פ — commercial and multi-unit projects']
  customer_association_number varchar(9)   [note: 'מ״ע — institutional projects']
  customer_address            varchar(200) [note: 'Address of the customer as captured on the project screen']
  customer_city               varchar(80)  [note: 'Private and luxury projects']
  customer_phone              varchar(20)  [note: 'Phone of the customer as captured on the project screen']
  customer_email              varchar(254) [note: 'Email of the customer as captured on the project screen']
  customer_floor              smallint     [note: 'Private, luxury and institutional projects; negative for underground floors']
  apartment_ownership enum_projects_apartment_ownership [note: 'Optional apartment classification: landowner or buyer']
  apartment_credit numeric [note: 'Optional nonnegative ILS amount; at most 2 decimal places; blank remains null']
  customer_apartment          varchar(10)  [note: 'Private and luxury projects']
  customer_unit               varchar(60)  [note: 'Institutional projects: unit or wing']
  address                     varchar(255) [note: 'Project site address as formatted by Google Places; set together with address_place_id']
  address_place_id            text         [note: 'Google Places id; its presence marks the address as verified']
  address_city                varchar(80)  [note: 'Locality component of the Places result']
  contact_name                varchar(120) [note: 'Project contact person: full name']
  contact_phone               varchar(20)  [note: 'Project contact person: Israeli mobile']
  contact_role                varchar(60)  [note: 'Project contact person: role, e.g. מנהל פרויקט']
  notes                       varchar(4000) [note: 'On a building: notes every apartment shows read-only (incl. תמ"א). On an apartment: its own notes']
  created_at      timestamptz(3)  [not null, default: `now()`, note: 'When the project was created']
  updated_at      timestamptz(3)  [not null, default: `now()`, note: 'When the project row last changed']
  deleted_at      timestamptz(3)  [note: 'Set when the project is removed; null while active']

  indexes {
    stage_id
    project_type_id
    customer_id
    parent_project_id
    (parent_project_id, customer_apartment) [unique, note: 'Live apartments only: one apartment number per building']
  }
  Note: 'The central work item: a site the company installs air conditioning in. A project is either a standalone project or, for multi-unit buildings, an apartment that points at its building through parent_project_id. It carries the customer details, the site address, the Drive folder, the team and the board stage. Soft deleted.'
}

Table project_members {
  id         uuid        [pk, default: `gen_random_uuid()`, note: 'Identifier of the assignment']
  project_id uuid        [not null, ref: > projects.id, note: 'The project or apartment the user is assigned to']
  user_id    uuid        [not null, ref: > users.id, note: 'The assigned employee']
  role       user_role   [not null, note: 'Project slots only: engineer, secretary, project_manager, installer']
  created_at timestamptz(3) [not null, default: `now()`, note: 'When the user was assigned']
  updated_at timestamptz(3) [not null, default: `now()`, note: 'When the assignment last changed, for example when the slot was handed to another user']

  indexes {
    (project_id, role) [unique]
    user_id
  }
  Note: 'The team assigned to a project: at most one user per role slot. Apartments normally inherit the building team; a row here for an apartment means it overrides that inheritance.'
}

Table project_stage_transitions {
  id              uuid         [pk, default: `gen_random_uuid()`, note: 'Identifier of the transition entry']
  project_id      uuid         [not null, ref: > projects.id, note: 'The project that moved']
  from_stage_id   uuid         [ref: > project_stages.id, note: 'Stage the project left; null for the first entry of a project']
  to_stage_id     uuid         [not null, ref: > project_stages.id, note: 'Stage the project moved into']
  changed_by_id   uuid         [not null, ref: > users.id, note: 'The user who moved the project']
  changed_by_role user_role    [not null, note: 'Snapshot of the role at the time of the change']
  note            varchar(255) [note: 'Optional free-text reason recorded with the move']
  created_at      timestamptz(3)  [not null, default: `now()`, note: 'When the move happened; orders the project history']

  indexes {
    (project_id, created_at)
  }
  Note: 'History of project movements across the board: one row per stage change, so the current stage on the project can always be explained by who moved it, when and why.'
}

Table drive_template_folders {
  id         uuid         [pk, default: `gen_random_uuid()`, note: 'Identifier of the template folder']
  parent_id  uuid         [ref: > drive_template_folders.id, note: 'Parent template folder; null for a folder directly under the project root']
  name       varchar(200) [not null, note: 'May contain {Project_ID}, {Project_Name}']
  position   integer      [not null, note: 'Order of the folder among its siblings']
  created_at timestamptz(3)  [not null, default: `now()`, note: 'When the template folder was defined']
  updated_at timestamptz(3)  [not null, default: `now()`, note: 'When the template folder last changed']
  Note: 'Template of the Google Drive folder tree created for every new project. Rows form a tree through parent_id; the names may contain placeholders that are filled in from the project.'
}

Enum task_type {
  quotation [note: 'הצעת מחיר — automatic mandatory project task, cannot be deleted or relinked']
  planning  [note: 'תכנון — automatic mandatory project task, cannot be deleted or relinked']
  general   [note: 'כללי — only manually created type; legacy tasks retain their links']
}

Enum task_status {
  waiting_for_response [note: 'מחכה לתשובה']
  not_started          [note: 'טרם בעבודה']
  in_progress          [note: 'בעבודה']
  in_review            [note: 'בבדיקה']
  proposal_sent        [note: 'נשלחה הצעה']
}

Table tasks {
  id            uuid           [pk, default: `gen_random_uuid()`, note: 'Identifier of the task']
  project_id    uuid           [note: 'Required for new tasks. Nullable for retained legacy customer tasks. Customer resolved through project']
  customer_id   uuid           [note: 'Legacy only; new tasks store NULL. chk_tasks_has_link retained; protected types require a project and NULL customer']
  assignee_id   uuid           [note: 'Nullable until a manager assigns the task']
  created_by_id uuid           [not null, note: 'The user who created the task; automatic quotation and planning tasks use the project creator']
  task_type     task_type      [not null, default: 'general', note: 'quotation and planning are the automatic protected types; general is the only manually creatable one']
  title         varchar(212)   [not null, note: 'Manual input remains 200 characters; storage fits the complete 200-character project name and automatic title prefix']
  description   text           [note: 'Free-text details of what has to be done']
  status        task_status    [not null, default: 'not_started', note: 'Current position of the task in its workflow; every change is recorded in task_status_transitions']
  is_urgent     boolean        [not null, default: false, note: 'false → true is the became-urgent transition; notification dispatch belongs to the task module']
  urgency_marked_by_id uuid [note: 'Current marker; null for legacy urgent rows with unknown audit']
  urgency_marked_at timestamptz(3) [note: 'Paired with marker; both clear when urgency is removed']
  due_date      timestamptz(3) [note: 'When the task is due; null when no date was set, and such tasks sort last']
  created_at    timestamptz(3)  [not null, default: `now()`, note: 'When the task was created']
  updated_at    timestamptz(3)  [not null, default: `now()`, note: 'When the task row last changed']
  deleted_at    timestamptz(3)  [note: 'Set when the task is removed; protected types keep their slot even once deleted']

  indexes {
    (project_id, task_type) [name: 'uq_tasks_project_protected_type', unique, note: 'Partial: quotation/planning only. Completed and deleted rows retain lifetime slots']
    (assignee_id, status) [name: 'idx_tasks_assignee_id_status', note: 'Partial index: WHERE deleted_at IS NULL']
    project_id [name: 'idx_tasks_project_id', note: 'Partial index: WHERE deleted_at IS NULL']
    customer_id [name: 'idx_tasks_customer_id', note: 'Partial index: WHERE deleted_at IS NULL']
    (is_urgent, due_date, id) [name: 'idx_tasks_urgency_due_date', note: 'Urgency DESC, due date ASC NULLS LAST, id ASC; active rows only']
  }
  Note: 'Work items inside a project. Each project automatically gets the two protected tasks quotation and planning, which cannot be deleted or relinked; general tasks are created manually. Legacy rows may still hang off a customer instead of a project. Soft deleted.'
}

Ref: tasks.project_id > projects.id [delete: restrict]
Ref: tasks.customer_id > customers.id [delete: restrict]
Ref: tasks.assignee_id > users.id [delete: restrict]
Ref: tasks.created_by_id > users.id [delete: restrict]

Ref: tasks.urgency_marked_by_id > users.id [delete: restrict]

Table quotation_execution_emails {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identifier of the dispatch record']
  task_id uuid [not null, ref: > tasks.id, note: 'The quotation task the email belongs to; one email per task']
  request_id uuid [not null, note: 'Client-supplied idempotency key, so a retried send does not deliver twice']
  sender_user_id uuid [not null, ref: > users.id, note: 'The user who sent the email']
  architect_contact_id uuid [not null, ref: > customer_contacts.id, note: 'The architect contact the request is addressed to']
  plan_file_id varchar(128) [not null, note: 'Drive file ID of the plan attached to the request']
  zip_file_id varchar(128) [not null, note: 'Drive file ID of the ZIP attached alongside the plan; must differ from plan_file_id']
  plan_version varchar(80) [not null, note: 'Version label of the plan that was sent, so later revisions stay distinguishable']
  recipient_contact_ids uuid[] [not null, note: 'Customer contacts chosen as recipients']
  recipient_emails text[] [not null, note: 'Resolved recipient addresses; at least one is required']
  subject text [not null, note: 'Subject line of the sent email']
  body text [not null, note: 'Body of the sent email']
  status varchar(20) [not null, note: 'preparing, sending, sent, failed, uncertain; chk_quotation_execution_email_status']
  provider_message_id varchar(255) [note: 'Message ID returned by the mail provider once accepted']
  error_code varchar(100) [note: 'Provider error code when the send failed; null on success']
  created_at timestamptz(3) [not null, default: `now()`, note: 'When the dispatch was recorded']
  updated_at timestamptz(3) [not null, default: `now()`, note: 'When the dispatch status last changed']

  indexes {
    task_id [name: 'uq_quotation_execution_emails_task', unique]
  }
  Note: 'The one outgoing execution request email per quotation task: which plan and ZIP were sent to which architect and recipients, and how the provider answered. chk_quotation_execution_email_distinct_files requires different plan and ZIP IDs; chk_quotation_execution_email_recipients requires at least one email.'
}

Table task_status_transitions {
  id            uuid           [pk, default: `gen_random_uuid()`, note: 'Identifier of the transition entry']
  task_id       uuid           [not null, note: 'The task that changed status']
  from_status   task_status    [note: 'Null for the creation entry; differs from to_status']
  to_status     task_status    [not null, note: 'Status the task moved into']
  changed_by_id uuid           [not null, note: 'The user who changed the status']
  changed_by_role user_role    [note: 'Role active for the actor when the transition occurred; null for historical entries without a reliable snapshot']
  created_at    timestamptz(3)  [not null, default: `now()`, note: 'When the status change happened; orders the task history']

  indexes {
    (task_id, created_at) [name: 'idx_task_status_transitions_task_created']
  }
  Note: 'History of task status changes, including the creation entry. Explains how a task reached its current status and who moved it.'
}

Ref: task_status_transitions.task_id > tasks.id [delete: restrict]
Ref: task_status_transitions.changed_by_id > users.id [delete: restrict]

Table project_stage_reset_snapshots {
  project_id uuid [pk, ref: > projects.id, note: 'The project whose stage was rewritten by the migration']
  previous_stage_id uuid [not null, ref: > project_stages.id, note: 'Stage the project sat in before the migration, used to restore it if needed']
  previous_updated_at timestamptz(3) [not null, note: 'The updated_at the project carried before the migration touched it']
  migrated_at timestamptz(3) [not null, default: `now()`, note: 'When the migration rewrote this project']
  Note: 'One-time recovery snapshot for the 2026-10-16 fixed-status migration. Includes all pre-existing projects, including apartments and soft-deleted records; not a user-generated transition.'
}

Table project_status_change_snapshots {
  project_id uuid [pk, ref: > projects.id, note: 'Project remapped by the engineering four-status migration']
  previous_stage_id uuid [not null, ref: > project_stages.id, note: 'Previous status ID for exact recovery']
  previous_updated_at timestamptz(3) [not null, note: 'Previous project timestamp']
  migrated_at timestamptz(3) [not null, default: `now()`, note: 'When the assignment was remapped']
  Note: 'Recovery record for the 2026-11-09 status migration. Includes active and soft-deleted projects whose status ID changed. Deleted with its project. RLS enabled; no public or API-role grants.'
}

Table permissions {
  key text [pk, note: 'Registered feature.action permission; chk_permissions_key_format requires a nonempty feature and action']
  Note: 'Catalog of every permission the backend can check. The key itself contains feature.action (for example quotations.approve), so feature and action are derived when needed rather than stored again. Maintained by migrations only.'
}

Table role_permissions {
  role user_role [not null, note: 'The role receiving the permission']
  permission_key text [not null, ref: > permissions.key, note: 'The granted permission from the permissions catalog']
  indexes {
    (role, permission_key) [pk]
    permission_key [name: 'idx_role_permissions_permission_key']
  }
  Note: 'Which permissions each role holds. Authorisation resolves a user active role to this list; grants change only through reviewed migrations.'
}

Enum enum_projects_apartment_ownership {
  landowner [note: 'בעל קרקע — the apartment belongs to the landowner']
  buyer     [note: 'רוכש — the apartment belongs to a buyer']
}


Table catalogue_items {
  id uuid [pk, note: 'Internal catalogue identifier; the stable key quotation lines and usage counters point at']
  sku varchar(200) [not null, note: 'Catalogue item number (מק״ט) of the product line: a manufacturer model number such as ARNU09GM1A4, an internal code such as 2033, or free text. Business identifier, not the primary key: unique only among active, non-deleted rows, searched together with description, and snapshotted onto quotation_items.sku']
  description varchar(1000) [not null, note: 'Catalogue wording of the product, used as the default quotation line text and searched together with sku']
  unit varchar(40) [not null, note: 'Unit the item is sold in, for example יח or מטר']
  price numeric(16,4) [not null, note: 'List price per unit in ILS, 4 decimal places; nonnegative, and used as the starting point for the price actually quoted on a line']
  capacity_btu integer [note: 'Cooling capacity in BTU/h for units; null for items without a capacity. Search ranks candidates by distance from the requested capacity']
  brand varchar(100) [not null, note: 'Manufacturer, for example LG or הייסנס; empty means the item fits any brand tab and is required for the General tab']
  system_type varchar(10) [note: 'System the item belongs to: VRF, MULTI or SINGLE. Null fits any system type; the seeded catalogue also stores an empty string, which the item picker does not match when a system is filtered on']
  equipment_role varchar(30) [not null, note: 'What the item is in the system: indoor, outdoor, unit, control, central, header, pipe or other']
  equipment_types jsonb [not null, note: 'Array of finer product variants, for example קסטה or לחץ גבוה; the first entry becomes the default on a new quotation line']
  status varchar(20) [not null, note: 'active (selectable), archived (withdrawn), nosell (not to be sold) or conflict (duplicate SKU awaiting an administrative winner); only active items can be picked']
  preference varchar(20) [not null, note: 'Selling hint: used ranks the item up in search, less marks it as less useful and raises a required warning, empty is neutral']
  includes_remote boolean [not null, note: 'The unit price already includes a remote control, so adding a separate remote accessory is rejected as double billing']
  includes_thermostat boolean [not null, note: 'The unit price already includes a thermostat, so adding a separate thermostat accessory is rejected as double billing']
  created_at timestamptz [note: 'When the catalogue item was created']
  updated_at timestamptz [note: 'When the catalogue item last changed']
  deleted_at timestamptz [note: 'Set when the item is removed from the catalogue; null while it exists']
  indexes {
    (status,brand,equipment_role,system_type) [note: 'Serves status, brand, role and system filters in the quotation item picker']
    sku [note: 'Unique partial active/not-deleted index uq_catalogue_active_sku']
  }
  Note: 'The price list of everything that can be put on a quotation: indoor and outdoor units, controls, headers, piping and other goods. Rows are imported from the reviewed source catalogue and maintained by catalogue managers; quotation lines copy from here rather than pointing at live prices. Soft deleted.'
}

Table quotations {
  rule_configuration jsonb [not null, note: 'Snapshot of the quotation_rules settings this quotation was last evaluated against, so an approved offer keeps the rules it was approved under']
  id uuid [pk, note: 'Internal quotation identifier referenced by its sections']
  number varchar(40) [not null, note: 'Human-facing quotation number YYMM-000001; the prefix comes from the month the quotation was created, the sequence is allocated under a monthly lock, and editing date afterwards never renumbers it']
  customer_id uuid [not null, note: 'The customer the offer is made to; its payment terms seed this quotation once']
  project_id uuid [note: 'The project the offer belongs to; null for an offer not yet tied to one']
  status varchar(20) [not null, note: 'draft, review or approved; any content change resets it to draft']
  date date [not null, note: 'Date shown on the offer; the number prefix is set from the creation month and does not change when this date is edited']
  brand varchar(100) [not null, note: 'First manufacturer for compatibility with older clients; empty when no brand tab exists']
  brands jsonb [not null, note: 'Ordered list of manufacturer tabs; the General tab is always available and is not stored here']
  warning_scope_version smallint [not null, note: '1 preserves warning acknowledgements on approved pre-tab quotations; 2 evaluates VRF warnings per system']
  payment_terms varchar(40) [note: 'other, prepaid, milestones_net_60, installments_10_60_30 or twelve_prepaid_checks; copied once from the customer and then owned by the quotation']
  payment_terms_note varchar(1000) [not null, note: 'Free-text payment wording shown on the offer; starts empty']
  payment_schedule jsonb [not null, note: 'Array of payment stages, each with its text and percent; a schedule that does not total 100 blocks approval outright and must be corrected, it cannot be acknowledged']
  discount_percent numeric(7,4) [not null, note: 'Discount applied to the line subtotal, 0 to 100; ignored when target_pretax_amount is set']
  target_pretax_amount numeric(16,2) [note: 'Nonnegative pretax total the offer is forced to, overriding discount_percent including when zero; null means the percentage applies']
  vat_rate numeric(7,4) [not null, note: 'VAT percentage applied to the discounted pretax total; new quotations default to 18']
  internal_notes varchar(5000) [not null, note: 'Notes for the team only; never part of the customer-facing offer']
  version integer [not null, note: 'Optimistic-locking counter, positive and required on save, so concurrent edits cannot overwrite each other']
  acknowledged_warnings jsonb [not null, note: 'Keys of the required warnings an approver explicitly accepted; cleared on any content save or rule fingerprint change']
  created_by_id uuid [not null, note: 'The user who created the quotation']
  updated_by_id uuid [not null, note: 'The user who last saved the quotation']
  approved_by_id uuid [note: 'The user who approved it; cleared whenever the content changes again']
  approved_at timestamptz [note: 'When it was approved; cleared together with approved_by_id']
  created_at timestamptz [note: 'When the quotation was created']
  updated_at timestamptz [note: 'When the quotation last changed; drives the activity list order']
  deleted_at timestamptz [note: 'Set when the quotation is removed; null while active, though deleted rows still hold their number']
  indexes {
    number [unique]
    customer_id
    project_id
    created_by_id
    updated_by_id
    approved_by_id
    (updated_at,id) [note: 'Keyset pagination of the activity list, newest first']
  }
  Note: 'A price offer (הצעת מחיר) for one customer, optionally tied to a project. The aggregate root of the quotation builder: sections hold the lines, totals are computed from them, and the status walks draft → review → approved. Every content save returns it to draft and clears the approval. Soft deleted.'
}

Table quotation_sections {
  id uuid [pk, note: 'Identifier of the section, referenced by its lines']
  quotation_id uuid [not null, note: 'The quotation the section belongs to']
  title varchar(200) [not null, note: 'Heading of the block as it appears on the offer']
  system_type varchar(10) [not null, note: 'VRF, MULTI, SINGLE or GEN (general works); decides which catalogue items the lines may use and which rules apply']
  brand varchar(100) [note: 'Manufacturer tab owning this section; null means the General tab and permits only unbranded catalogue items']
  display_order integer [not null, note: 'Position of the section within the quotation; unique per quotation']
  created_at timestamptz [note: 'When the section was created']
  updated_at timestamptz [note: 'When the section last changed']
  deleted_at timestamptz [note: 'Set when the section is removed; null while active']
  indexes {
    (quotation_id,display_order) [unique]
  }
  Note: 'A system block inside a quotation (for example the VRF system or the general works), grouping the lines that belong together and fixing their order on the printed offer.'
}

Table quotation_items {
  catalogue_status varchar(20) [not null, note: 'Catalogue status copied when the line was selected; while the quotation is not yet approved reads overlay the current catalogue status on top of it, and an approved quotation keeps this stored value. A line pointing at a nosell item raises a required warning']
  control_kind varchar(20) [note: 'remote or thermostat for control lines, derived from the catalogue wording; null for anything that is not a control']
  catalogue_preference varchar(20) [not null, note: 'Preference the catalogue item had when the line was added; less raises a required less-useful warning']
  id uuid [pk, note: 'Identifier of the line, also used as the parent reference of its accessories']
  section_id uuid [not null, note: 'The section the line appears in']
  catalogue_item_id uuid [not null, note: 'The catalogue item the line was built from; kept for traceability and usage counting']
  parent_item_id uuid [note: 'For a control accessory, the indoor unit line it belongs to in the same section; the quantities must match and the parent must not already include that control']
  sku varchar(200) [not null, note: 'Catalogue item number copied from the catalogue item when the line was created, so the offer keeps the number it was priced with']
  description varchar(1000) [not null, note: 'Line wording; the catalogue description unless the user typed their own']
  unit varchar(40) [not null, note: 'Unit of sale copied from the catalogue item']
  quoted_price numeric(16,4) [not null, note: 'Price per unit actually quoted, nonnegative and editable; starts from the catalogue price, and a quoted price of zero raises a required warning']
  quantity numeric(12,4) [not null, note: 'How many units are quoted; must be greater than zero']
  equipment_role varchar(30) [not null, note: 'Role copied from the catalogue item: indoor, outdoor, control, header, pipe and so on; the rules use it to check system completeness']
  equipment_type varchar(100) [note: 'Chosen product variant, defaulting to the first of the catalogue equipment_types']
  capacity_btu integer [note: 'Capacity in BTU/h of the selected item; null for items without one']
  requested_capacity_btu integer [note: 'Capacity the engineer asked for; a large gap from capacity_btu raises a required warning']
  location varchar(200) [not null, note: 'Where the unit goes on site, for example סלון; empty when not relevant']
  circuit varchar(1) [note: 'Single-letter circuit label tying indoor units to their outdoor unit; null uses default circuit A for VRF indoor and outdoor lines']
  display_order integer [not null, note: 'Position of the line within its section; unique per section']
  includes_remote boolean [not null, note: 'Copied from the catalogue item: the line price already covers a remote, so a separate remote accessory is rejected']
  includes_thermostat boolean [not null, note: 'Copied from the catalogue item: the line price already covers a thermostat, so a separate thermostat accessory is rejected']
  created_at timestamptz [note: 'When the line was first added; preserved when the line is edited']
  updated_at timestamptz [note: 'When the line last changed']
  deleted_at timestamptz [note: 'Set when the line is removed; null while it is part of the offer']
  indexes {
    (section_id,display_order) [unique]
    catalogue_item_id
    parent_item_id
  }
  Note: 'One priced line in a quotation section. Each line is a snapshot of the catalogue item it was built from — number, wording, unit, capacity and included accessories are copied, so later catalogue edits never change an existing offer. Control accessories hang off their indoor unit through parent_item_id.'
}

Table catalogue_item_usage {
  id uuid [pk, note: 'Identifier of the usage counter row']
  user_id uuid [not null, note: 'The user whose selections are counted']
  catalogue_item_id uuid [not null, note: 'The catalogue item that was selected']
  selection_count integer [not null, note: 'How many times this user persisted a line with this item; positive, and unchanged lines never increment it']
  last_selected_at timestamptz [not null, note: 'When this user last chose the item']
  created_at timestamptz [note: 'When the counter row was created']
  updated_at timestamptz [note: 'When the counter last changed']
  deleted_at timestamptz [note: 'Set when the counter is discarded; ignored rows no longer influence ranking']
  indexes {
    (user_id,catalogue_item_id) [unique]
    catalogue_item_id
  }
  Note: 'Per-user record of how often each catalogue item was actually chosen. The item picker ranks frequently used items first, so each user sees the products they work with most.'
}
Ref: quotations.customer_id > customers.id
Ref: quotations.project_id > projects.id
Ref: quotations.created_by_id > users.id
Ref: quotations.updated_by_id > users.id
Ref: quotations.approved_by_id > users.id
Ref: quotation_sections.quotation_id > quotations.id
Ref: quotation_items.section_id > quotation_sections.id
Ref: quotation_items.catalogue_item_id > catalogue_items.id
Ref: quotation_items.parent_item_id > quotation_items.id
Ref: catalogue_item_usage.user_id > users.id
Ref: catalogue_item_usage.catalogue_item_id > catalogue_items.id

Table quotation_rules {
  key varchar(60) [pk, note: 'Rule name the backend recognises, for example zero_price, capacity_distance, vrf_ratio, missing_outdoor or payment_schedule']
  enabled boolean [not null, note: 'Whether the rule is evaluated; disabling it stops its warning from being raised']
  version integer [not null, note: 'Positive revision of the rule, incremented whenever a migration changes it, so quotations can tell the settings apart']
  parameters jsonb [not null, note: 'Object of thresholds for the rule, for example maximumDeviation for capacity_distance or minimumRatio and maximumRatio for vrf_ratio; empty for rules without settings']
  created_at timestamptz [note: 'When the rule row was created']
  updated_at timestamptz [note: 'When the rule setting last changed']
  Note: 'Switchboard for the quotation validation rules: which checks run and with what thresholds. Most failing checks become required warnings that block approval until resolved or acknowledged; payment terms and schedule issues must be resolved. Changed only through reviewed migrations; there is no rules UI.'
}


Table questionnaires {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identifier of this questionnaire version']
  slug varchar(120) [not null, note: 'Stable public name of the questionnaire, shared by all its versions and used in the form URL']
  version integer [not null, note: 'Positive; immutable with the complete definition']
  title text [not null, note: 'Heading shown at the top of the form']
  introduction text [not null, note: 'Explanatory text shown above the questions']
  definition jsonb [not null, note: 'Array of version-specific field definitions; immutable']
  accepting_responses boolean [not null, default: false, note: 'Whether this version is the one currently open for submissions; at most one version per slug may be open']
  created_at timestamptz(3) [not null, default: `now()`, note: 'When the version was published']
  updated_at timestamptz(3) [not null, default: `now()`, note: 'When accepting_responses was last toggled']
  indexes {
    (slug, version) [unique, name: 'uq_questionnaires_slug_version']
    slug [name: 'uq_questionnaires_accepting_slug', note: 'Unique partial index WHERE accepting_responses']
  }
  Note: 'A published version of an internal questionnaire form, with its questions frozen in definition. Versions cannot be deleted. Only accepting_responses and updated_at may change. RLS enabled, no public Data API grants.'
}

Table questionnaire_submissions {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Identifier of the submission']
  questionnaire_id uuid [not null, note: 'The exact questionnaire version that was filled in']
  request_id uuid [not null, unique, note: 'Client-supplied idempotency key, so a retried submit is stored once']
  full_name varchar(200) [not null, note: 'Self-reported, nonblank; original text preserved']
  role varchar(200) [not null, note: 'Self-reported, nonblank']
  department varchar(200) [not null, note: 'Self-reported, nonblank']
  answers jsonb [not null, note: 'Array of questionKey/value pairs; each version-specific question appears once; at least one nonblank answer']
  created_at timestamptz(3) [not null, default: `now()`, note: 'When the form was submitted']
  indexes {
    questionnaire_id [name: 'idx_questionnaire_submissions_questionnaire_id']
  }
  Note: 'One filled-in questionnaire response, tied to the exact version that was answered. Append-only. Trigger validates answer identity, uniqueness, types and per-question length against the immutable questionnaire. RLS enabled, no public Data API grants.'
}
Ref: questionnaire_submissions.questionnaire_id > questionnaires.id [delete: restrict]
