# Every hosted environment (development, test, production) sets its own values in Railway.
# Copy to .env for local development; never commit .env.

PORT=3000

DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<supabase-project-ref>
DB_PASS=
DB_SSL=true
DB_SSL_CA=
DB_LOGGING=false
MAX_CONNECTIONS=10

JWT_SECRET=
AUTH_CLIENT_SECRET=

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=

GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
WORKER_URL=http://localhost:3001
WORKER_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_APPLICATION_CREDENTIALS=

FORCE_JSON_LOGS=false
USE_PRETTY_PRINT=false

RATE_LIMIT_REFRESH_TIME=
RATE_LIMIT_MAX_REQUESTS_MULTIPLIER=
