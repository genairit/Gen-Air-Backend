{
  "name": "gen-air-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "check:drive": "ts-node -r tsconfig-paths/register src/scripts/check-google-drive.ts",
    "create-admin": "node dist/scripts/create-admin.js"
  },
  "dependencies": {
    "@googleapis/drive": "^26.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "axios": "^1.19.0",
    "class": "^0.1.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crc-32": "^1.2.2",
    "joi": "^18.2.5",
    "morgan": "^1.11.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-pyramid-imports": "^1.0.1",
    "prettier-plugin-pyramid-interface-keys": "^1.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@Dto/(.*)$": "<rootDir>/dto/$1",
      "^@Guards/(.*)$": "<rootDir>/guards/$1",
      "^@Logger/(.*)$": "<rootDir>/logger/$1",
      "^@Modules/(.*)$": "<rootDir>/modules/$1",
      "^@Constants/(.*)$": "<rootDir>/constants/$1",
      "^@Providers/(.*)$": "<rootDir>/providers/$1",
      "^@Utilities/(.*)$": "<rootDir>/utilities/$1",
      "^@Decorators/(.*)$": "<rootDir>/decorators/$1",
      "^@Interfaces/(.*)$": "<rootDir>/interfaces/$1"
    }
  }
}
